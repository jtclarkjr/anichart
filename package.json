{
  "name": "anichart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:ssr": "bun run dev-unified.ts",
    "dev:ssr:legacy": "bun run dev-ssr.ts",
    "dev:ssr:simple": "PORT=5174 bun run server.ts",
    "pre-build": "vp check && vp test run --passWithNoTests --environment jsdom",
    "build-only": "vp build",
    "build:client": "vp build --outDir dist/client",
    "build:server": "vp build --ssr src/entry-server.ts --outDir dist/server",
    "build:ssr": "vp run build:client && vp run build:server",
    "start": "NODE_ENV=production bun run server-prod.ts",
    "preview:ssr": "vp run build:ssr && vp run start",
    "build": "vp run pre-build && vp run build:ssr",
    "test:unit": "vp test run --passWithNoTests --environment jsdom",
    "test:storybook": "vp test run --config vitest.storybook.config.ts",
    "test:storybook:install-browser": "playwright install chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check .",
    "prepare": "vp config"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@jtclarkjr/component-library-vue": "0.4.2",
    "@vercel/analytics": "^2.0.1",
    "graphql": "^17.1.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.15",
    "@pinia/testing": "^1.0.3",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "bun-types": "^1.4.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "sass": "^1.108.2",
    "start-server-and-test": "^2.1.5",
    "storybook": "^10.6.7",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@vitest/browser": "5.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vitest": "5.1.0"
  }
}
